# Application Settings
APP_NAME=DriftGuards
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_KEY=your-secret-api-key-here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1

# Terraform Configuration
TERRAFORM_BINARY_PATH=/usr/local/bin/terraform
TERRAFORM_STATE_BACKEND=s3
TERRAFORM_STATE_BUCKET=driftguards-terraform-state
TERRAFORM_STATE_KEY=terraform.tfstate
TERRAFORM_WORKING_DIR=/app/terraform

# driftctl Configuration
DRIFTCTL_BINARY_PATH=/usr/local/bin/driftctl
DRIFTCTL_CACHE_DIR=/tmp/driftctl-cache

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./driftguards.db
# For DynamoDB (production)
# DYNAMODB_TABLE_DRIFTS=DriftGuardsRecords
# DYNAMODB_TABLE_REMEDIATIONS=DriftGuardsRemediations
# DYNAMODB_TABLE_POLICIES=DriftGuardsPolicies

# S3 Configuration
S3_BUCKET_ARTIFACTS=driftguards-artifacts
S3_BUCKET_LOGS=driftguards-logs
S3_PREFIX_REPORTS=drift-reports/
S3_PREFIX_BACKUPS=backups/
S3_PREFIX_TERRAFORM_STATES=terraform-states/

# CloudWatch Configuration
CLOUDWATCH_METRICS_NAMESPACE=DriftGuards
CLOUDWATCH_LOG_GROUP=/driftguards/app
CLOUDWATCH_LOOKBACK_HOURS=24

# AWS Config Configuration
CONFIG_LOOKBACK_DAYS=7

# Cost Explorer Configuration
COST_EXPLORER_LOOKBACK_DAYS=30

# Alert Configuration
ALERT_EMAIL_FROM=alerts@driftguards.io
ALERT_EMAIL_TO=team@driftguards.io
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_PAGERDUTY_API_KEY=your-pagerduty-api-key
ALERT_PAGERDUTY_SERVICE_ID=your-pagerduty-service-id

# SES Configuration
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@driftguards.io

# SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:driftguards-alerts

# OPA Configuration
OPA_POLICY_DIR=/app/app/policies/opa
OPA_ENABLED=true

# Scanning Configuration
SCAN_INTERVAL_HOURS=1
SCAN_PARALLEL_WORKERS=5
SCAN_TIMEOUT_MINUTES=30
SCAN_RESOURCE_TYPES=aws_instance,aws_s3_bucket,aws_rds_instance,aws_lambda_function

# Remediation Configuration
REMEDIATION_AUTO_APPROVE=false
REMEDIATION_BACKUP_ENABLED=true
REMEDIATION_DRY_RUN=true
REMEDIATION_TIMEOUT_MINUTES=15

# Policy Configuration
POLICY_ENFORCEMENT_LEVEL=warn  # Options: ignore, warn, block
POLICY_AUTO_REMEDIATE=false

# Security Configuration
SECRET_KEY=your-secret-key-for-jwt-tokens-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_BACKEND=memory  # Options: memory, redis
REDIS_URL=redis://localhost:6379/0

# Monitoring Configuration
XRAY_ENABLED=false
METRICS_ENABLED=true

# Frontend Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# GitHub Configuration (for GitOps features)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-infrastructure-repo
GITHUB_BASE_BRANCH=main
