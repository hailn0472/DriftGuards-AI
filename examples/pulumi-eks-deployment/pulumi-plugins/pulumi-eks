#!/bin/bash

# EKS Cluster Deployment Script
echo "🚀 Starting EKS cluster deployment..."

# Initialize Pulumi stack if needed
if ! pulumi stack ls | grep -q "dev"; then
    echo "📋 Creating Pulumi stack..."
    pulumi stack init dev
fi

# Select the dev stack
pulumi stack select dev

# Set AWS region if not set
if [ -z "$AWS_REGION" ]; then
    export AWS_REGION="ap-southeast-1"
fi

echo "🌍 Using AWS region: $AWS_REGION"

# Configure AWS region in Pulumi
pulumi config set aws:region $AWS_REGION

# Deploy the EKS cluster
echo "⚡ Deploying EKS cluster..."
if [ "$1" = "--yes" ]; then
    pulumi up --yes
else
    pulumi up
fi

if [ $? -eq 0 ]; then
    echo "✅ EKS cluster deployment completed successfully!"
    echo ""
    echo "📊 Cluster Information:"
    pulumi stack output cluster_name
    pulumi stack output cluster_endpoint
    pulumi stack output cluster_version
    echo ""
    echo "🔧 To configure kubectl:"
    echo "$(pulumi stack output kubeconfig_command)"
    echo ""
    echo "🧪 To test cluster:"
    echo "$(pulumi stack output cluster_status_command)"
    echo ""
    echo "🗑️  To destroy cluster:"
    echo "pulumi-eks-down"
else
    echo "❌ EKS cluster deployment failed!"
    exit 1
fi